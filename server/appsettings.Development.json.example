    "Host": "",
    "Port": "587",
    "User": "",
    "Password": "",
    "From": ""
  },
  "Billing": {
    "_comment": "Mock=true лише для локального демо без реальних грошей. У Production Mock=true заборонено (сервер впаде на старті).",
    "Mock": true,
    "FreeLimit": 3,
    "Price": 100,
    "Currency": "UAH",
    "ProductName": "Швидке додавання — повний доступ",
    "ApiBaseUrl": "http://localhost:5080",
    "ClientReturnUrl": "http://localhost:5173/app/quick-add",
    "WayForPay": {
      "MerchantAccount": "ВАШ_MERCHANT_ACCOUNT",
