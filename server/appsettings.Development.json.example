{
  "_comment": "Скопіюйте цей файл у appsettings.Development.json і підставте реальні значення. Справжній appsettings.Development.json у git НЕ комітиться (див. .gitignore) — він містить секрети.",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=planner;User=planner;Password=ВАШ_ПАРОЛЬ_БД;"
